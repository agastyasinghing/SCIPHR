# SCIPHR Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or service_account.json to git.
#
# CREDENTIAL ROTATION CHECKLIST (PRD §14 — Critical P0 Security Actions)
# Both credentials below must be rotated before any deploy if they were ever
# stored unprotected or committed to git, even briefly:
#
#   1. GEMINI_API_KEY — rotate at: https://aistudio.google.com/app/apikey
#      (or whichever Google Cloud project issued the key)
#
#   2. Google service account key (GOOGLE_APPLICATION_CREDENTIALS) —
#      rotate at: Google Cloud Console → IAM → Service Accounts →
#      select account → Keys → Add Key (then delete the old key)
#
# These are two separate credentials. Rotating one does not rotate the other.

# Google Vertex AI (Imagen — AI poster generation)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# CORS — comma-separated list of allowed frontend origins
# Dev default (http://localhost:5173) is used if this var is unset.
# Set to your production Vercel URL before deploy.
# Example: ALLOWED_ORIGINS=https://sciphr.vercel.app,https://sciphr.ai
ALLOWED_ORIGINS=

# Anthropic Claude API (AI analysis)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# The Odds API (value bet engine — Phase 2)
ODDS_API_KEY=your-odds-api-key-here

# PostgreSQL — Supabase connection string (Phase 1)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Redis — Upstash (Phase 6, rate limiter + cache)
UPSTASH_REDIS_URL=
